# ─────────────────────────────────────────────────────────────────────────────
# Animal Medicine Information System — Backend Environment Variables
# Copy this file to .env and update values as needed
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="Animal Medicine Information System"
APP_VERSION="1.0.0"
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/animal_medicine_db

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Inventory Thresholds ──────────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=10
EXPIRY_ALERT_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed origins for the frontend
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
